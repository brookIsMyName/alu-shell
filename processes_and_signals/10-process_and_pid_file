#!/usr/bin/env bash
# Manage PID file and handle termination signals

pid_file="/var/run/myscript.pid"

cleanup() {
    rm -f "$pid_file"
    exit 0
}

trap 'echo "I hate the kill command"' SIGTERM
trap 'echo "Y U no love me?!"' SIGINT
trap 'cleanup' SIGQUIT

echo "$$" > "$pid_file"

while true
do
    echo "To infinity and beyond"
    sleep 2 &
    wait $!
done
